	(require-all
		(global-name "com.apple.SharedWebCredentials")
		(require-any
			(require-entitlement "com.apple.private.canGetAppLinkInfo")
			(require-entitlement "com.apple.private.canModifyAppLinkPermissions")))
	(require-all
		(global-name "com.apple.ak.auth.xpc")
		(require-any
			(process-attribute 9)
			(require-entitlement "com.apple.authkit.client")
			(require-entitlement "com.apple.authkit.client.private")
			(require-entitlement "com.apple.authkit.client.internal")))
	(require-all
		(global-name "com.apple.ak.anisette.xpc")
		(require-any
			(process-attribute 9)
			(require-entitlement "com.apple.authkit.client")
			(require-entitlement "com.apple.authkit.client.private")
			(require-entitlement "com.apple.authkit.client.internal")))
	(require-all
		(global-name "com.apple.networkd_privileged")
		(require-any
			(require-entitlement "com.apple.networkd.advisory_socket")
			(require-entitlement "com.apple.networkd.disable_opportunistic")
			(require-entitlement "com.apple.networkd.modify_settings")
			(require-entitlement "com.apple.networkd.persistent_interface")
			(require-entitlement "com.apple.networkd_privileged"))))
(allow mach-register
	(extension "com.apple.sandbox.application-group")
	(local-name "com.apple.iphone.axserver")
	(local-name "com.apple.accessibility.gax.client")
	(local-name "com.apple.assistant.contextprovider.")
	(require-all
		(global-name-regex #".+")
		(extension "com.apple.security.exception.mach-register.global-name"))
	(require-all
		(local-name-regex #".+")
		(extension "com.apple.security.exception.mach-register.local-name")))
(allow network-inbound
	(require-all
		(literal "/private/var/")
		(extension "com.apple.sandbox.application-group")
		(require-any
			(require-any (regex #"/private/var/Users/[^/]+/Containers/Shared/AppGroup/[^/]+/")
(regex #"/private/var/PersonaVolumes/[^/]+/Containers/Shared/AppGroup/[^/]+/"))
			(require-all
				(subpath-prefix "${HOME}")
				(regex #"^/private/var/mobile/Containers/Shared/AppGroup/[^/]+/" #"^/private/var/euser[0-9]+/Containers/Shared/AppGroup/[^/]+/" #"^/private/var/[-0-9A-F]+/Containers/Shared/AppGroup/[^/]+/" #"^/private/var/Users/[^/]+/Containers/Shared/AppGroup/[^/]+/"))))
	(require-all
		(subpath-prefix "${HOME}/Library/Mobile Documents")
		(require-any
			(extension "com.apple.librarian.ubiquity-container")
			(require-entitlement "com.apple.private.librarian.container-proxy")
			(require-all
				(extension "com.apple.app-sandbox.read-write")
				(subpath-prefix "${HOME}/Library/Mobile Documents")))))
(allow network-outbound)
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
