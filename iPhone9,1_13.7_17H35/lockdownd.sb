					(subpath "/System/Library/PrivateFrameworks")
					(require-any (literal "/private/etc/group")
(literal "/private/etc/services"))
					(literal "/private/etc/passwd")
					(require-any (literal-prefix "${FRONT_USER_HOME}/Library/Application Support/com.apple.palette.green.bin")
(literal-prefix "${FRONT_USER_HOME}/Library/Application Support/com.apple.palette.green.plist"))
					(require-any (literal "/private/etc/fstab")
(literal "/private/etc/protocols"))
					(subpath "/System/Library/Frameworks")
					(literal "/")
					(literal "/private/etc/hosts")
					(subpath "/private/var/MobileAsset/PreinstalledAssetsV2/InstallWithOs")
					(require-entitlement "com.apple.itunesstored.private")
					(require-entitlement "com.apple.watchlist.private")
					(require-entitlement "com.apple.proactive.AppPrediction.predictions")
					(require-entitlement "com.apple.private.avatar.store")
					(require-all
						(require-any (literal-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/CloudConfigurationSetAsideDetails.plist")
(literal-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/CloudConfigurationSetAsideDetails.plist"))
						(process-attribute 9))
					(require-all
						(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationSetAsideDetails.plist")
						(process-attribute 9))
					(require-all
						(require-any (literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist")
(literal-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/CloudConfigurationDetails.plist")
(literal-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/CloudConfigurationDetails.plist"))
						(process-attribute 9))
					(require-all
						(subpath-prefix "${FRONT_USER_HOME}/Library/Caches/com.apple.AppleMediaServices")
						(require-entitlement "com.apple.private.applemediaservices"))
					(require-all
						(subpath-prefix "${HOME}/Library/Caches/com.apple.proactive.eventtracker")
						(require-entitlement "com.apple.proactive.eventtracker"))
					(require-all
						(subpath-prefix "${HOME}/Library/Assets")
						(require-entitlement "com.apple.private.assets.accessible-asset-types")
						(extension "com.apple.assets.read"))
					(require-all
						(literal-prefix "${HOME}/Library/Caches/PassKit/cache.plist")
						(require-entitlement "com.apple.private.contactsui"))
					(require-all
						(subpath "/private/var/MobileAsset")
						(require-entitlement "com.apple.private.assets.accessible-asset-types")
						(extension "com.apple.assets.read"))
					(require-all
						(subpath-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge")
