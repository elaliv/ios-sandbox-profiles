(allow network-inbound
	(local ip "*:*")
	(require-all
		(subpath-prefix "${HOME}/Library/Mobile Documents")
		(require-any
			(extension "com.apple.librarian.ubiquity-container")
			(extension "com.apple.app-sandbox.read-write")
			(require-entitlement "com.apple.private.librarian.container-proxy")))
	(require-all
		(literal "/private/var/")
		(extension "com.apple.sandbox.application-group")
		(require-any (regex #"/private/var/Users/[^/]+/Containers/Shared/AppGroup/[^/]+/")
(regex #"/private/var/PersonaVolumes/[^/]+/Containers/Shared/AppGroup/[^/]+/"))
		(require-entitlement "com.apple.private.amfi.can-execute-cdhash")))
(allow network-outbound
	(require-all
		(subpath-prefix "${HOME}/Library/Mobile Documents")
		(require-any
			(extension "com.apple.librarian.ubiquity-container")
			(extension "com.apple.app-sandbox.read-write")
			(require-entitlement "com.apple.private.librarian.container-proxy")))
	(require-all
		(process-attribute 9)
		(literal "/private/var/run/lockdown.sock"))
	(require-all
		(remote tcp "localhost:873")
		(remote tcp "localhost:62078")
		(remote tcp "localhost:22")
		(remote tcp "localhost:23")
		(require-any
			(require-any (control-name "com.apple.netsrc")
(control-name "com.apple.network.statistics"))
			(literal "/private/var/run/mDNSResponder")
			(literal "/private/var/run/printd")
			(remote ip "*:*")
			(require-all
				(extension "com.apple.sandbox.application-group")
				(literal "/private/var/")
				(require-any (regex #"/private/var/Users/[^/]+/Containers/Shared/AppGroup/[^/]+/")
(regex #"/private/var/PersonaVolumes/[^/]+/Containers/Shared/AppGroup/[^/]+/"))
				(require-entitlement "com.apple.private.amfi.can-execute-cdhash"))
			(require-all
				(subpath-prefix "${HOME}/Library/Mobile Documents")
				(require-any
					(extension "com.apple.librarian.ubiquity-container")
					(require-entitlement "com.apple.private.librarian.container-proxy")
					(require-all
						(extension "com.apple.app-sandbox.read-write")
						(subpath-prefix "${HOME}/Library/Mobile Documents"))))
			(require-all
				(vnode-type SOCKET)
				(literal-prefix "${FRONT_USER_HOME}/Library/ExternalAccessory/ea")))))
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
(allow socket-ioctl)
(allow system-privilege)
