				(global-name "com.apple.logd.admin")
				(require-any
					(require-entitlement "com.apple.private.logging.diagnostic")
					(require-entitlement "com.apple.diagnosticd.diagnostic")))
			(require-all
				(global-name "com.apple.springboard.statusbarservices")
				(require-entitlement "com.apple.springboard.statusbarstyleoverrides"))
			(require-all
				(global-name "com.apple.passd.trusted-device-enrollment-info-provider")
				(require-entitlement "com.apple.private.passkit.trusted-device-enrollment-info"))
			(require-all
				(global-name "com.apple.bulletinboard.dataproviderconnection")
				(require-entitlement "com.apple.bulletinboard.dataprovider"))
			(require-all
				(global-name "com.apple.appstored.xpc.updates")
				(require-any
					(require-entitlement "com.apple.itunesstored.private")
					(require-entitlement "com.apple.appstored.update-apps")))
			(require-all
				(require-any (global-name "com.apple.appstored.xpc.request")
(global-name "com.apple.appstored.xpc.jobmanager"))
				(require-entitlement "com.apple.appstored.install-apps")))))
(allow mach-register
	(global-name "com.apple.nehelper")
	(global-name "com.apple.networkd_privileged")
	(require-all
		(local-name-regex #".+")
		(extension "com.apple.security.exception.mach-register.local-name"))
	(require-all
		(extension "com.apple.security.exception.mach-register.global-name")
		(global-name-regex #".+")))
(allow network*
	(local udp "*:4500")
	(local udp "*:500")
	(literal "/private/var/run/racoon.sock"))
(allow network-outbound
	(require-any (control-name "com.apple.netsrc")
(control-name "com.apple.network.statistics"))
	(require-any (control-name "com.apple.network.advisory")
(control-name "com.apple.net.netagent")
(control-name "com.apple.net.necp_control")
(control-name "com.apple.net.utun_control")
(control-name "com.apple.content-filter")
(control-name "com.apple.flow-divert"))
	(control-name "com.apple.net.ipsec_control")
	(literal "/private/var/run/mDNSResponder")
	(remote udp "*:*")
	(remote tcp "*:*")
	(literal "/private/var/run/syslog"))
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
(allow process-info*)
(allow process-info-codesignature)
(allow process-info-dirtycontrol)
(allow process-info-listpids)
(allow process-info-rusage)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow process-info-pidfileportinfo)
(allow process-info-setcontrol)
(allow socket-ioctl)
(allow sysctl*
	(require-any (sysctl-name "kern.ipc.io_policy.throttled")
(sysctl-name "net.")))
(allow sysctl-read
	(require-any (sysctl-name "kern.ipc.io_policy.throttled")
(sysctl-name "net."))
	(require-any (sysctl-name "net.statistics")
(sysctl-name "kern.ipc.maxsockbuf"))
	(sysctl-name "net.routetable.")
	(extension "com.apple.security.exception.sysctl.read-write")
	(sysctl-name "kern.nisdomainname")
	(extension "com.apple.security.exception.sysctl.read-only")
	(require-any (sysctl-name "kern.procargs2.")
(sysctl-name "kern.proc."))
	(require-entitlement "com.apple.security.exception.process-info")
	(require-all
		(process-attribute 9)
		(require-any (sysctl-name "kern.proc.pid.")
(sysctl-name "kern.argmax")))
	(require-all
		(require-not (sysctl-name "sysctl.proc_native"))
		(require-any
			(require-any (sysctl-name "hw.logicalcpu_max")
(sysctl-name "hw.logicalcpu")
(sysctl-name "hw.l3cachesize_compat")
(sysctl-name "hw.l3cachesize")
(sysctl-name "hw.l3settings")
(sysctl-name "hw.l1dcachesize")
