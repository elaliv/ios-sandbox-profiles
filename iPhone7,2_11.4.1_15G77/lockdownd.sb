(deny file-read-data
	(require-all
		(extension "com.apple.sandbox.executable")
		(regex #"/[^/]+/SC_Info/" #".+/[^/]+/SC_Info/")))
(deny file-write*
	(regex #"^/private/var/containers/Data/System/[^/]+/[.]com[.]apple[.]")
	(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]")
	(require-all
		(require-all (require-not (literal-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge/knowledgeC.db"))
(require-not (literal-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge/knowledgeC.db-journal"))
(require-not (literal-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge/knowledgeC.db-shm"))
(require-not (literal-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge/knowledgeC.db-wal"))
(require-not (literal-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge"))
(require-not (subpath "/private/var/root/Library/Lockdown"))
(require-not (literal "/private/var/root/Library/Preferences/com.apple.mobile.lockdownd.plist"))
(require-not (subpath "/private/var/preferences/SystemConfiguration")))
		(require-not (extension "com.apple.security.exception.files.home-relative-path.read-write"))
		(require-not (extension "com.apple.app-sandbox.read-write"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-write"))
		(require-not (literal "/private/var/run/lockdown.sock"))
		(require-not (subpath "/private/var/run/lockdown"))
		(require-not (subpath "/private/var/logs"))
		(require-not (subpath-prefix "${HOME}/Library/Lockdown"))
		(require-not (subpath-prefix "${FRONT_USER_HOME}/Media"))
		(require-any
			(vnode-type CHARACTER-DEVICE)
			(vnode-type BLOCK-DEVICE)
			(require-all
				(extension "com.apple.sandbox.system-container")
				(require-entitlement "com.apple.security.system-container")))))
(deny file-write-create
	(require-all
		(literal-prefix "${HOME}/Library/Caches/sharedCaches/com.apple.iTunesStore.NSURLCache")
		(require-entitlement "com.apple.itunesstored.private")))
(deny file-write-data
	(require-all
		(require-not (literal "/dev/aes_0"))
		(require-any (literal "/dev/urandom")
(literal "/dev/random"))))
(deny file-write-setugid)
(deny sysctl-read
	(require-all
		(require-all (require-not (sysctl-name "kern.ipc.maxsockbuf"))
(require-not (sysctl-name "kern.nisdomainname"))
(require-not (sysctl-name "net.routetable."))
(require-not (sysctl-name "net.statistics")))
		(require-not (extension "com.apple.security.exception.sysctl.read-only"))
		(require-not (extension "com.apple.security.exception.sysctl.read-write"))
		(sysctl-name "sysctl.proc_native")))
