		(require-all (require-not (literal "/System/Library/Caches/apticket.der"))
(require-not (subpath "/System/Library/Caches/com.apple.kernelcaches"))
(require-not (subpath "/System/Library/Caches/com.apple.factorydata")))
		(require-any
