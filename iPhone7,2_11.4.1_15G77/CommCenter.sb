(version 1)
(deny default)
(allow dynamic-code-generation)
(allow file-ioctl
	(require-any (literal "/dev/uart.debug")
(literal "/dev/uart.debug.log")
(literal "/dev/uart.umts")
(literal "/dev/dlci.spi-baseband.")
(literal "/dev/bbcdc.")
(literal "/dev/cu.debug")
(literal "/dev/mux.spi-baseband")
(literal "/dev/mux.log"))
	(subpath "/private/var/wireless")
	(literal "/dev/uart.log"))
(allow file-issue-extension
	(require-all
		(extension-class "com.apple.app-sandbox.read-write")
		(require-any
			(extension "com.apple.security.exception.files.absolute-path.read-write")
			(extension "com.apple.security.exception.files.home-relative-path.read-write")
