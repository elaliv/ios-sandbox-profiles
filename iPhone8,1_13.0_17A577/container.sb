(allow ipc-posix-sem*
	(semaphore-owner self)
	(require-all
		(extension "com.apple.sandbox.application-group")
		(require-not (require-entitlement "com.apple.private.amfi.can-execute-cdhash"))))
(allow ipc-posix-sem-open
	(require-any (ipc-posix-name "containermanagerd.fb_check")
(ipc-posix-name "purplebuddy.sentinel")))
(allow ipc-posix-shm-read-data
	(ipc-posix-name "/com.apple.AppSSO.version")
	(require-any (ipc-posix-name "apple.cfprefs.")
(ipc-posix-name "apple.shm.notification_center"))
	(ipc-posix-name-regex #"^gdt-[0-9A-Za-z]+-c$" #"^gdt-[0-9A-Za-z]+-s$")
	(ipc-posix-name-regex #"^AppleABL[.]." #"^AppleABL[.].+")
	(require-all
		(ipc-posix-name "AppleABL")
		(require-entitlement "inter-app-audio"))
	(require-all
		(require-any (ipc-posix-name "Apple MIDI in ")
(ipc-posix-name "Apple MIDI out "))
		(ipc-posix-name-regex #"^Apple MIDI in [0-9]+$" #"^Apple MIDI out [0-9]+$")))
(allow ipc-posix-shm-write-create
	(ipc-posix-name-regex #"^/mono[.][0-9]+$"))
(allow ipc-posix-shm-write-data
	(ipc-posix-name-regex #"^gdt-[0-9A-Za-z]+-c$" #"^gdt-[0-9A-Za-z]+-s$")
	(ipc-posix-name-regex #"^AppleABL[.]." #"^AppleABL[.].+")
	(require-all
		(ipc-posix-name "AppleABL")
		(require-entitlement "inter-app-audio"))
	(require-all
		(require-any (ipc-posix-name "Apple MIDI in ")
(ipc-posix-name "Apple MIDI out "))
		(ipc-posix-name-regex #"^Apple MIDI in [0-9]+$" #"^Apple MIDI out [0-9]+$")))
(allow ipc-posix-shm-write-unlink
	(ipc-posix-name-regex #"^gdt-[0-9A-Za-z]+-c$" #"^gdt-[0-9A-Za-z]+-s$"))
(allow lsopen)
(allow mach-cross-domain-lookup)
