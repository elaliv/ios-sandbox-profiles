			(sysctl-name "kern.bootsessionuuid")
			(require-any (sysctl-name "kern.memorystatus_level")
(sysctl-name "hw.ncpu")
(sysctl-name "hw.model")))))
(allow system-fsctl
	(fsctl-command (_IO "J" 72))
	(fsctl-command (_IO "J" 71))
	(fsctl-command (_IO "J" 2))
	(fsctl-command (_IO "J" 32))
	(fsctl-command (_IO "A" 20))
	(fsctl-command (_IO "J" 68))
	(fsctl-command (_IO "J" 57)))
(allow system-package-check)
(allow system-privilege)
(allow user-preference-read
	(preference-domain "com.apple.DocumentManager.defaults")
	(preference-domain "kCFPreferencesAnyApplication")
	(preference-domain "com.apple.purplebuddy")
	(preference-domain "com.apple.fileproviderd")
	(extension "com.apple.security.exception.shared-preference.read-write")
	(extension "com.apple.security.exception.shared-preference.read-only")
	(preference-domain "com.apple.Accessibility")
	(preference-domain "com.apple.hangtracer")
	(preference-domain "com.apple.AppStore")
	(preference-domain "com.apple.MobileStore")
	(preference-domain "com.apple.itunesstored")
	(preference-domain "com.apple.storeservices.itfe")
	(require-entitlement "com.apple.itunesstored.private")
	(require-all
		(preference-domain "com.apple.demo-settings")
		(process-attribute 9))
	(require-all
		(preference-domain "com.apple.PrototypeTools")
		(require-any
			(require-all
				(preference-domain "com.apple.security")
				(process-attribute 9))
			(require-all
				(preference-domain "com.apple.imessage.bag")
				(require-any
					(require-entitlement "com.apple.private.ids.remoteurlconnection")
					(require-entitlement "com.apple.private.imcore.imremoteurlconnection")))
			(require-all
				(preference-domain "com.apple.facetime.bag")
				(require-any
					(require-entitlement "com.apple.private.ids.remoteurlconnection")
					(require-entitlement "com.apple.private.imcore.imremoteurlconnection")))
			(require-all
				(preference-domain "com.apple.springboard")
				(require-entitlement "com.apple.watchlist.private"))
			(require-all
				(preference-domain "com.apple.WatchListKit")
				(require-entitlement "com.apple.watchlist.private"))
			(require-all
				(preference-domain "com.apple.AppleMediaServices")
				(require-entitlement "com.apple.private.applemediaservices"))
			(require-all
				(preference-domain "com.apple.AvatarUI.Staryu")
				(require-entitlement "com.apple.private.avatar.store"))
			(require-all
				(preference-domain "com.apple.avfoundation.frecents")
				(require-entitlement "com.apple.avfoundation.allows-access-to-device-list"))
			(require-all
				(preference-domain "com.apple.MobileAsset")
				(require-entitlement "com.apple.private.assets.accessible-asset-types"))
			(require-all
				(preference-domain "com.apple.bulletinboard")
				(require-entitlement "com.apple.bulletinboard.dataprovider"))
			(require-all
				(preference-domain "com.apple.proactive.PersonalizationPortrait")
				(require-entitlement "com.apple.coreduetd.allow")))))
(allow managed-preference-read
	(preference-domain "kCFPreferencesAnyApplication")
	(extension "com.apple.security.exception.managed-preference.read-only"))
(allow user-preference-write
	(preference-domain "com.apple.fileproviderd"))
(allow syscall-unix)
