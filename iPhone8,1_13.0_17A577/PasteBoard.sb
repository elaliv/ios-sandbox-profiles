						(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/" #"^/private/var/containers/Shared/SystemGroup/[^/]+$"))))))
	(require-all
		(literal "/private/var/containers/Data/System/")
		(regex #"^/private/var/containers/Data/System/[^/]+/" #"^/private/var/containers/Data/System/[^/]+$")))
(allow iokit-open)
(allow iokit-set-properties)
(allow iokit-get-properties)
(allow ipc-posix-shm*)
(allow ipc-posix-shm-read-data)
(allow ipc-posix-shm-write*)
(allow ipc-posix-shm-write-create)
(allow ipc-posix-shm-write-data)
(allow ipc-posix-shm-write-unlink)
(allow lsopen)
(allow mach-cross-domain-lookup)
(allow mach-lookup
	(global-name "com.apple.pluginkit.pkd")
	(extension "com.apple.pluginkit.plugin-service")
	(global-name "com.apple.diagnosticd")
	(require-any (global-name "com.apple.system.notification_center")
(global-name "com.apple.system.logger"))
	(require-any (global-name "com.apple.CoreAuthentication.daemon.libxpc")
(global-name "com.apple.ctkd.token-client"))
	(global-name "com.apple.system.libinfo.muser")
	(global-name "com.apple.distributed_notifications@1v3")
	(global-name "com.apple.analyticsd")
	(global-name "com.apple.managedconfiguration.profiled.public")
	(require-any (xpc-service-name "com.apple.accessibility.BrailleTranslation.BrailleTranslationService")
(xpc-service-name "com.apple.siri.embeddedspeech")
(xpc-service-name "com.apple.WebKit.Networking")
(xpc-service-name "com.apple.WebKit.WebContent")
(xpc-service-name "com.apple.SpeechRecognitionCore.speechrecognitiond"))
	(xpc-service-name "com.apple.MTLCompilerService")
	(xpc-service-name "com.apple.imfoundation.IMRemoteURLConnectionAgent")
	(process-attribute 9)
	(global-name "com.apple.mobile.usermanagerd.xpc")
	(global-name "com.apple.logd.events")
	(require-any (global-name "com.apple.lsd")
(global-name "com.apple.lsd.icons"))
	(require-all
		(global-name-regex #".+")
		(extension "com.apple.security.exception.mach-lookup.global-name"))
	(require-all
		(local-name-regex #".+")
		(extension "com.apple.security.exception.mach-lookup.local-name")))
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
(allow process-exec*
	(literal "/System/Library/Frameworks/UIKit.framework/Support/pasteboardd"))
(allow process-info*)
(allow process-info-codesignature)
(allow process-info-dirtycontrol)
(allow process-info-listpids)
(allow process-info-rusage)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow process-info-pidfileportinfo)
(allow process-info-setcontrol)
(allow socket-ioctl)
(allow sysctl-read
	(extension "com.apple.security.exception.sysctl.read-write")
	(extension "com.apple.security.exception.sysctl.read-only")
	(sysctl-name "sysctl.proc_native")
	(require-all
		(process-attribute 9)
		(require-any (sysctl-name "kern.proc.pid.")
(sysctl-name "kern.argmax"))))
(allow system-privilege)
(allow syscall-unix)
