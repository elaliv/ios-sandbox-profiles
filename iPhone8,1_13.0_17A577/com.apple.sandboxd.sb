(version 1)
(deny default)
(allow darwin-notification-post)
(allow dynamic-code-generation)
(allow file-clone)
(allow file-ioctl
	(literal "/dev/dtracehelper"))
(allow file-link)
(allow file-map-executable)
(allow file-read*)
(allow file-read-data)
(allow file-read-metadata)
(allow file-read-xattr)
(allow file-test-existence)
(allow file-write*
	(subpath-prefix "${PROCESS_TEMP_DIR}")
	(extension "com.apple.sandbox.system-group")
	(require-all
		(literal "/private/var/mobile/Library/Logs/CrashReporter/")
		(regex #"^/private/var/mobile/Library/Logs/CrashReporter/Sandbox-.+[.]ips" #"^/private/var/mobile/Library/Logs/CrashReporter/[.]Sandbox-.+[.]ips"))
	(require-all
		(literal "/private/var/logs/CrashReporter/")
		(regex #"^/private/var/logs/CrashReporter/Sandbox-.+[.]ips" #"^/private/var/logs/CrashReporter/[.]Sandbox-.+[.]ips"))
	(require-all
		(require-not (file-mode #o0000))
		(literal "/cores/")))
(allow file-write-data
	(require-any (literal "/dev/null")
(literal "/dev/zero"))
	(literal "/dev/dtracehelper"))
(allow iokit-get-properties)
(allow ipc-posix-shm*
	(ipc-posix-name "apple.shm.notification_center"))
(allow ipc-posix-shm-read-data
	(ipc-posix-name "apple.cfprefs."))
(allow mach-cross-domain-lookup)
(allow mach-lookup
	(global-name "com.apple.diagnosticd")
	(global-name "com.apple.logd.events")
	(require-any (global-name "com.apple.system.notification_center")
(global-name "com.apple.system.logger"))
	(global-name "com.apple.mobile.keybagd.UserManager.xpc")
	(global-name "com.apple.rtcreportingd")
	(global-name "com.apple.mobile.keybagd.xpc")
	(global-name "com.apple.system.libinfo.muser")
	(global-name "com.apple.aggregated")
	(global-name "com.apple.OTATaskingAgent")
	(global-name "com.apple.system.DirectoryService.libinfo_v1")
	(global-name "com.apple.mobilegestalt.xpc")
	(global-name "com.apple.cfprefsd.daemon")
	(global-name "com.apple.cfprefsd.agent")
	(global-name "com.apple.coresymbolicationd")
	(global-name "com.apple.logd")
	(global-name "com.apple.containermanagerd")
	(local-name "com.apple.cfprefsd.agent")
	(xpc-service-name-regex #".+"))
(allow mach-task-name)
(allow network-outbound
	(literal "/private/var/run/asl_input"))
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
(allow process-info*)
(allow process-info-codesignature)
(allow process-info-dirtycontrol)
(allow process-info-listpids)
(allow process-info-rusage)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow process-info-pidfileportinfo)
(allow process-info-setcontrol)
(allow socket-ioctl)
(allow sysctl*
	(require-any (sysctl-name "security.mac.sandbox.autotracing.rate")
(sysctl-name "security.mac.sandbox.autotracing.max_proc")))
(allow sysctl-read)
(allow system-privilege)
(allow syscall-unix)
