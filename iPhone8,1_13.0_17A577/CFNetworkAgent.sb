(version 1)
(deny default)
(allow darwin-notification-post)
(allow dynamic-code-generation)
(allow file-clone)
(allow file-link)
(allow file-read*
	(subpath "/private/var/preferences/Logging")
	(literal "/private/var/Managed Preferences/mobile/.GlobalPreferences.plist")
	(subpath-prefix "${FRONT_USER_HOME}/XcodeBuiltProducts")
	(literal-prefix "${FRONT_USER_HOME}/Library/Preferences/.GlobalPreferences.plist")
	(extension "com.apple.quicklook.readonly")
	(extension "com.apple.security.exception.files.home-relative-path.read-only")
	(extension "com.apple.app-sandbox.read")
	(extension "com.apple.app-sandbox.read-write")
	(extension "com.apple.sandbox.executable")
	(extension "com.apple.security.exception.files.absolute-path.read-only")
	(extension "com.apple.security.exception.files.home-relative-path.read-write")
	(extension "com.apple.security.exception.files.absolute-path.read-write")
	(extension "com.apple.sharing.airdrop.readonly")
	(require-any (subpath "/private/var/db/timesync")
(subpath "/private/var/userdata/diagnostics"))
	(subpath "/private/var/db/uuidtext")
	(subpath "/private/var/db/diagnostics")
	(subpath-prefix "${HOME}/Library/Logs/com.apple.StoreServices")
	(subpath-prefix "${HOME}/Library/Caches/sharedCaches/com.apple.iTunesStore.NSURLCache")
	(subpath-prefix "${HOME}/Library/Caches/sharedCaches/com.apple.WatchListKit.NSURLCache")
	(subpath-prefix "${HOME}/Library/com.apple.WatchListKit")
	(literal-prefix "${HOME}/Library/Cookies/com.apple.itunesstored")
	(require-all
		(require-all (require-not (subpath "/System/Library/Caches/com.apple.factorydata"))
(require-not (subpath "/System/Library/Caches/com.apple.kernelcaches"))
(require-not (literal "/System/Library/Caches/apticket.der")))
		(require-any
			(subpath "/usr/lib")
			(subpath "/private/var/db/timezone")
			(subpath "/System/Library")
			(subpath "/usr/share")
			(subpath "/Library/RegionFeatures")
			(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.nsurlstoragedresources/Library/dafsaData.bin")
			(literal "/private/var/preferences/com.apple.networkd.plist")
			(literal "/private/var/Managed Preferences/mobile/com.apple.SystemConfiguration.plist")
			(literal "/private/var/preferences/com.apple.security.plist")
			(literal "/private/var/preferences/com.apple.NetworkStatistics.plist")
			(subpath "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.icloud.findmydevice.managed/Library")
			(require-any (literal "/dev/null")
(literal "/dev/zero"))
			(literal "/dev/aes_0")
			(require-any (literal "/dev/urandom")
(literal "/dev/random"))
			(require-any (subpath-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/PublicInfo")
(subpath-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/PublicInfo")
(subpath "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/PublicInfo"))
			(subpath "/private/var/db/datadetectors/sys")
			(literal "/dev/dtracehelper")
			(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist")
			(require-entitlement "com.apple.security.system-container")
			(require-all
				(literal "/private/var/preferences/com.apple.networkextension.plist")
				(require-entitlement "com.apple.private.networkextension.configuration"))
			(require-all
				(uid 0)
				(literal "/private/etc/master.passwd"))
			(require-all
				(extension "com.apple.sandbox.system-group")
				(require-any
					(require-all
						(require-entitlement "com.apple.security.system-groups")
						(literal "/private/var/containers/Shared/SystemGroup/")
						(require-any
							(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/")
							(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/" #"^/private/var/containers/Shared/SystemGroup/[^/]+$")))
					(require-all
						(require-entitlement "com.apple.security.system-group-containers")
						(literal "/private/var/containers/Shared/SystemGroup/")
						(require-any
							(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/")
							(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/" #"^/private/var/containers/Shared/SystemGroup/[^/]+$")))))
			(require-all
				(extension "com.apple.logd.read-only")
				(require-any
					(require-entitlement "com.apple.private.logging.diagnostic")
					(require-entitlement "com.apple.diagnosticd.diagnostic")))
			(require-all
				(vnode-type BLOCK-DEVICE)
				(vnode-type CHARACTER-DEVICE)
				(require-any
					(subpath "/Developer")
					(subpath "/System/Library/PrivateFrameworks")
					(literal "/")
					(require-any (literal-prefix "${FRONT_USER_HOME}/Library/Application Support/com.apple.palette.green.plist")
(literal-prefix "${FRONT_USER_HOME}/Library/Application Support/com.apple.palette.green.bin")
(literal "/private/etc/services")
(literal "/private/etc/group")
(subpath "/private/var/MobileAsset/PreinstalledAssetsV2/InstallWithOs"))
					(literal "/private/etc/passwd")
					(literal "/private/etc/hosts")
					(subpath "/System/Library/Frameworks")
					(literal "/private/etc/protocols")
					(require-entitlement "com.apple.itunesstored.private")
					(require-entitlement "com.apple.watchlist.private")
					(require-all
						(require-any (literal-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/CloudConfigurationSetAsideDetails.plist")
(literal-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/CloudConfigurationSetAsideDetails.plist"))
						(process-attribute 9))
					(require-all
						(require-any (literal-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/CloudConfigurationDetails.plist")
(literal-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/CloudConfigurationDetails.plist")
(literal-prefix "${FRONT_USER_HOME}")
(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist"))
						(process-attribute 9))
					(require-all
						(literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationSetAsideDetails.plist")
						(process-attribute 9))
					(require-all
						(vnode-type REGULAR-FILE)
						(subpath-prefix "${FRONT_USER_HOME}/Library/Caches/com.apple.nsurlsessiond/Downloads/com.apple.AppleMediaServices")
						(require-entitlement "com.apple.private.applemediaservices"))
					(require-all
						(vnode-type DIRECTORY)
						(subpath-prefix "${FRONT_USER_HOME}/Library/Caches/com.apple.nsurlsessiond/Downloads/com.apple.AppleMediaServices")
						(require-entitlement "com.apple.private.applemediaservices"))
					(require-all
						(subpath-prefix "${FRONT_USER_HOME}/Library/Caches/com.apple.AppleMediaServices")
						(require-entitlement "com.apple.private.applemediaservices"))
					(require-all
						(subpath-prefix "${FRONT_USER_HOME}/Library/DuetExpertCenter/caches")
						(require-entitlement "com.apple.proactive.AppPrediction.predictions"))
					(require-all
						(subpath-prefix "${HOME}/Library/Caches/com.apple.proactive.eventtracker")
						(require-entitlement "com.apple.proactive.eventtracker"))
					(require-all
						(require-any (subpath-prefix "${HOME}/Library/Avatar")
(subpath-prefix "${HOME}/Library/Caches/com.apple.AvatarUI"))
						(require-entitlement "com.apple.private.avatar.store"))
					(require-all
						(subpath-prefix "${HOME}/Library/Assets")
						(extension "com.apple.assets.read")
						(require-entitlement "com.apple.private.assets.accessible-asset-types"))
					(require-all
						(subpath "/private/var/MobileAsset")
						(extension "com.apple.assets.read")
						(require-entitlement "com.apple.private.assets.accessible-asset-types"))
					(require-all
						(literal-prefix "${HOME}/Library/Caches/PassKit/cache.plist")
						(require-entitlement "com.apple.private.contactsui"))
					(require-all
						(literal-prefix "${HOME}/Library/Preferences/com.apple.mobilephone.speeddial.plist")
						(require-entitlement "com.apple.private.contactsui"))
					(require-all
						(subpath-prefix "${FRONT_USER_HOME}/Library/CoreDuet/Knowledge")
						(require-entitlement "com.apple.coreduetd.allow"))
					(require-all
						(require-any (literal-prefix "${HOME}/Library/CoreDuet/People/interactionC.db")
(literal-prefix "${HOME}/Library/CoreDuet/People/interactionC.db-journal")
(literal-prefix "${HOME}/Library/CoreDuet/People"))
						(require-entitlement "com.apple.coreduetd.people"))
					(require-all
						(literal-prefix "${HOME}/Library/CoreDuet/People/interactionC.db-shm")
						(require-entitlement "com.apple.coreduetd.people"))
					(require-all
						(literal-prefix "${HOME}/Library/CoreDuet/People/interactionC.db-wal")
						(require-entitlement "com.apple.coreduetd.people"))))))
	(require-all
		(literal "/private/var/containers/Data/System/")
		(extension "com.apple.sandbox.system-container")
		(regex #"^/private/var/containers/Data/System/[^/]+/[.]com[.]apple[.]")
		(require-any
			(regex #"^/private/var/containers/Data/System/[^/]+/")
			(regex #"^/private/var/containers/Data/System/[^/]+/" #"^/private/var/containers/Data/System/[^/]+$")))
	(require-all
		(literal "/private/var/")
		(regex #"^/private/var/mobile/Media/iTunes_Control/iTunes/" #"^/private/var/mobile/Media/iTunes_Control/iTunes$" #"^/private/var/mobile/Media/[^/]+/iTunes_Control/iTunes/" #"^/private/var/mobile/Media/[^/]+/iTunes_Control/iTunes$" #"^/private/var/euser[0-9]+/Media/([^/]+/)?iTunes_Control/iTunes/" #"^/private/var/euser[0-9]+/Media/([^/]+/)?iTunes_Control/iTunes$" #"^/private/var/[-0-9A-F]+/Media/([^/]+/)?iTunes_Control/iTunes/" #"^/private/var/[-0-9A-F]+/Media/([^/]+/)?iTunes_Control/iTunes$" #"^/private/var/Users/[^/]+/Media/([^/]+/)?iTunes_Control/iTunes/" #"^/private/var/Users/[^/]+/Media/([^/]+/)?iTunes_Control/iTunes$")
		(subpath-prefix "${HOME}")))
(allow file-read-metadata
	(vnode-type SYMLINK)
	(literal-prefix "${HOME}")
	(literal-prefix "${HOME}/Library/Caches/powerlog.launchd")
	(literal-prefix "${HOME}/Library/Preferences")
	(extension "com.apple.quicklook.readonly")
	(extension "com.apple.security.exception.files.home-relative-path.read-only")
	(extension "com.apple.app-sandbox.read")
	(extension "com.apple.app-sandbox.read-write")
	(extension "com.apple.security.exception.files.absolute-path.read-only")
	(extension "com.apple.security.exception.files.home-relative-path.read-write")
	(extension "com.apple.security.exception.files.absolute-path.read-write")
	(extension "com.apple.sharing.airdrop.readonly")
	(literal "/private/var/run/syslog")
	(require-not (vnode-type DIRECTORY))
	(require-entitlement "com.apple.security.system-container")
	(require-all
		(extension "com.apple.sandbox.system-group")
		(require-any
			(require-all
				(require-entitlement "com.apple.security.system-groups")
				(literal "/private/var/containers/Shared/SystemGroup/")
				(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/"))
			(require-all
				(require-entitlement "com.apple.security.system-group-containers")
				(literal "/private/var/containers/Shared/SystemGroup/")
				(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/"))))
	(require-all
		(literal "/private/var/containers/Data/System/")
		(extension "com.apple.sandbox.system-container")
		(regex #"^/private/var/containers/Data/System/[^/]+/")))
(allow file-test-existence)
(allow iokit-open
	(extension "com.apple.security.exception.iokit-user-client-class")
	(iokit-user-client-class "AppleKeyStoreUserClient")
	(require-all
		(iokit-user-client-class "AppleAOPEnvSenseUserClient")
		(require-entitlement "com.apple.private.aop-envsense.user-access")))
(allow iokit-get-properties)
(allow lsopen)
(allow mach-cross-domain-lookup)
(allow network-outbound)
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
(allow process-info*)
(allow process-info-codesignature)
(allow process-info-dirtycontrol)
(allow process-info-listpids)
(allow process-info-rusage)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow process-info-pidfileportinfo)
(allow process-info-setcontrol)
(allow socket-ioctl)
(allow sysctl-read
	(sysctl-name "net.routetable.")
	(sysctl-name "kern.ipc.maxsockbuf")
	(sysctl-name "kern.nisdomainname")
	(extension "com.apple.security.exception.sysctl.read-write")
	(extension "com.apple.security.exception.sysctl.read-only")
	(sysctl-name "net.statistics")
	(require-any (sysctl-name "kern.procargs2.")
(sysctl-name "kern.proc."))
	(require-entitlement "com.apple.security.exception.process-info")
	(require-all
		(process-attribute 9)
		(require-any (sysctl-name "kern.proc.pid.")
(sysctl-name "kern.argmax")))
	(require-all
		(sysctl-name "sysctl.proc_native")
		(require-any
			(require-any (sysctl-name "hw.logicalcpu_max")
(sysctl-name "hw.logicalcpu")
(sysctl-name "hw.l1dcachesize")
(sysctl-name "hw.l1dcachesize_compat")
(sysctl-name "hw.l1icachesize_compat")
(sysctl-name "hw.l1icachesize")
(sysctl-name "hw.l3cachesize_compat")
(sysctl-name "hw.l3cachesize")
(sysctl-name "hw.l3settings")
(sysctl-name "hw.l2cachesize")
(sysctl-name "hw.l2cachesize_compat")
(sysctl-name "hw.l2settings")
(sysctl-name "hw.cachelinesize_compat")
(sysctl-name "hw.cachelinesize")
(sysctl-name "hw.cpufrequency_max")
(sysctl-name "hw.cpufrequency_compat")
(sysctl-name "hw.cpufrequency")
(sysctl-name "hw.cpufamily")
(sysctl-name "hw.cpusubtype")
(sysctl-name "hw.cpu64bit_capable")
(sysctl-name "hw.cputype")
(sysctl-name "hw.vectorunit")
(sysctl-name "hw.tbfrequency")
(sysctl-name "hw.tbfrequency_compat")
(sysctl-name "hw.memsize")
(sysctl-name "hw.machine")
(sysctl-name "hw.pagesize")
(sysctl-name "hw.pagesize_compat")
(sysctl-name "hw.physicalcpu")
(sysctl-name "hw.physicalcpu_max")
(sysctl-name "hw.physmem")
(sysctl-name "hw.usermem")
(sysctl-name "hw.busfrequency_compat")
(sysctl-name "hw.busfrequency")
(sysctl-name "hw.byteorder")
(sysctl-name "hw.activecpu")
(sysctl-name "kern.maxvnodes")
(sysctl-name "kern.maxproc")
(sysctl-name "kern.maxfilesperproc")
(sysctl-name "kern.monotonicclock")
(sysctl-name "kern.monotoniclock_offset_usecs")
(sysctl-name "kern.usrstack64")
(sysctl-name "kern.usrstack")
(sysctl-name "kern.hostid")
(sysctl-name "kern.hostname")
(sysctl-name "kern.ostype")
(sysctl-name "kern.osproductversion")
(sysctl-name "kern.osvariant_status")
(sysctl-name "kern.osversion")
(sysctl-name "kern.osrelease")
(sysctl-name "kern.clockrate")
(sysctl-name "kern.saved_ids")
(sysctl-name "kern.secure_kernel")
(sysctl-name "kern.ngroups")
(sysctl-name "kern.boottime")
(sysctl-name "kern.bootargs")
(sysctl-name "kern.development")
(sysctl-name "kern.waketime")
(sysctl-name "kern.version")
(sysctl-name "vm.loadavg")
(sysctl-name "sysctl.name2oid")
(sysctl-name "security.mac.sandbox.sentinel"))
			(sysctl-name "kern.bootsessionuuid")
			(require-any (sysctl-name "kern.memorystatus_level")
(sysctl-name "hw.ncpu")
(sysctl-name "hw.model")))))
(allow system-privilege)
(allow syscall-unix)
