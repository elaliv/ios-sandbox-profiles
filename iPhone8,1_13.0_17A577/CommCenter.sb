		(require-any (subpath-prefix "${HOME}/Library/Caches/com.apple.nsurlsessiond/Downloads/com.apple.coretelephony")
(subpath-prefix "${HOME}/Library/Caches/com.apple.nsurlsessiond/Downloads/com.apple.CommCenter")
(subpath-prefix "${HOME}/Library/Caches/com.apple.nsurlsessiond/Downloads/CommCenterClassic")))
	(require-all
