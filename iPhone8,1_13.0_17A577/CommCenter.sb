				(subpath-prefix "${HOME}/Library/Caches/sharedCaches/com.apple.iTunesStore.NSURLCache")
				(require-entitlement "com.apple.itunesstored.private")))))
(allow file-link)
(allow file-map-executable
	(subpath-prefix "${FRONT_USER_HOME}/XcodeBuiltProducts")
	(subpath "/usr/lib")
	(require-any (literal "/usr/local/lib/libSWBypassClient.dylib")
(literal "/usr/local/lib/CarrierBundleDevKey.dylib"))
	(subpath "/System/Library")
	(require-all
		(extension "com.apple.sandbox.executable")
		(regex #"/[^/]+/SC_Info/" #".+/[^/]+/SC_Info/"))
	(require-all
		(subpath "/AppleInternal")
		(subpath "/usr/local/lib")
		(subpath "/Developer")))
(allow file-read*
	(literal "/private/var/preferences/com.apple.networkd.plist")
	(require-any (subpath-prefix "${HOME}/Library/Caches/CommCenterClassic")
(subpath-prefix "${HOME}/Library/Caches/com.apple.CommCenter")
(subpath-prefix "${HOME}/Library/Caches/com.apple.coretelephony"))
	(literal "/private/var/preferences/SystemConfiguration/com.apple.radios.plist")
