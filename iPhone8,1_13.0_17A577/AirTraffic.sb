(allow process-info*)
(allow process-info-codesignature)
(allow process-info-dirtycontrol)
(allow process-info-listpids)
(allow process-info-rusage)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow process-info-pidfileportinfo)
(allow process-info-setcontrol)
(allow socket-ioctl)
(allow sysctl-read
	(sysctl-name "net.statistics")
	(sysctl-name "net.routetable.")
	(sysctl-name "kern.ipc.maxsockbuf")
	(sysctl-name "kern.nisdomainname")
	(sysctl-name "kern.bootsessionuuid")
	(extension "com.apple.security.exception.sysctl.read-write")
	(extension "com.apple.security.exception.sysctl.read-only")
	(require-any (sysctl-name "kern.procargs2.")
(sysctl-name "kern.proc."))
	(require-entitlement "com.apple.security.exception.process-info")
	(require-all
		(process-attribute 9)
		(require-any (sysctl-name "kern.proc.pid.")
(sysctl-name "kern.argmax")))
	(require-all
		(sysctl-name "sysctl.proc_native")
		(require-any
			(require-any (sysctl-name "hw.logicalcpu_max")
(sysctl-name "hw.logicalcpu")
(sysctl-name "hw.l1dcachesize")
(sysctl-name "hw.l1dcachesize_compat")
(sysctl-name "hw.l1icachesize_compat")
(sysctl-name "hw.l1icachesize")
(sysctl-name "hw.l3cachesize_compat")
(sysctl-name "hw.l3cachesize")
(sysctl-name "hw.l3settings")
(sysctl-name "hw.l2cachesize")
(sysctl-name "hw.l2cachesize_compat")
(sysctl-name "hw.l2settings")
(sysctl-name "hw.cachelinesize_compat")
(sysctl-name "hw.cachelinesize")
(sysctl-name "hw.cpufrequency_max")
(sysctl-name "hw.cpufrequency_compat")
(sysctl-name "hw.cpufrequency")
(sysctl-name "hw.cpufamily")
(sysctl-name "hw.cpusubtype")
(sysctl-name "hw.cpu64bit_capable")
(sysctl-name "hw.cputype")
(sysctl-name "hw.vectorunit")
(sysctl-name "hw.tbfrequency")
(sysctl-name "hw.tbfrequency_compat")
(sysctl-name "hw.memsize")
(sysctl-name "hw.machine")
(sysctl-name "hw.pagesize")
(sysctl-name "hw.pagesize_compat")
(sysctl-name "hw.physicalcpu")
(sysctl-name "hw.physicalcpu_max")
(sysctl-name "hw.physmem")
(sysctl-name "hw.usermem")
(sysctl-name "hw.busfrequency_compat")
(sysctl-name "hw.busfrequency")
(sysctl-name "hw.byteorder")
(sysctl-name "hw.activecpu")
(sysctl-name "kern.maxvnodes")
(sysctl-name "kern.maxproc")
(sysctl-name "kern.maxfilesperproc")
(sysctl-name "kern.monotonicclock")
(sysctl-name "kern.monotoniclock_offset_usecs")
(sysctl-name "kern.usrstack64")
(sysctl-name "kern.usrstack")
(sysctl-name "kern.hostid")
(sysctl-name "kern.hostname")
(sysctl-name "kern.ostype")
(sysctl-name "kern.osproductversion")
(sysctl-name "kern.osvariant_status")
(sysctl-name "kern.osversion")
(sysctl-name "kern.osrelease")
(sysctl-name "kern.clockrate")
(sysctl-name "kern.saved_ids")
(sysctl-name "kern.secure_kernel")
(sysctl-name "kern.ngroups")
(sysctl-name "kern.boottime")
(sysctl-name "kern.bootargs")
(sysctl-name "kern.development")
(sysctl-name "kern.waketime")
(sysctl-name "kern.version")
(sysctl-name "vm.loadavg")
(sysctl-name "sysctl.name2oid")
(sysctl-name "security.mac.sandbox.sentinel"))
			(sysctl-name "kern.bootsessionuuid")
			(require-any (sysctl-name "kern.memorystatus_level")
(sysctl-name "hw.ncpu")
(sysctl-name "hw.model")))))
(allow system-fsctl
	(fsctl-command (_IO "h" 29))
	(fsctl-command (_IO "h" 28))
	(fsctl-command (_IO "J" 18))
	(fsctl-command (_IO "h" 27)))
(allow system-privilege)
(allow user-preference-read
	(preference-domain "com.apple.Metal")
	(preference-domain "com.apple.logging")
	(preference-domain "com.apple.coremedia")
	(preference-domain "com.apple.coreaudio")
	(preference-domain "com.apple.GEO")
	(preference-domain "com.apple.CFNetwork")
	(preference-domain "com.apple.mobileipod")
	(preference-domain "kCFPreferencesAnyApplication")
	(preference-domain "com.apple.itunesstored")
	(preference-domain "com.apple.demo-settings")
	(preference-domain "com.apple.avfoundation")
	(preference-domain "com.apple.opengl")
	(preference-domain "com.apple.NanoRegistry")
	(preference-domain "com.apple.medialibrary")
	(preference-domain "com.apple.ids")
	(preference-domain "com.apple.homesharing")
	(preference-domain "com.apple.conference")
	(preference-domain "com.apple.pairedsync")
	(preference-domain "com.apple.iokit.IOMobileGraphicsFamily")
	(preference-domain "com.apple.marco")
	(preference-domain "com.apple.corevideo")
	(extension "com.apple.security.exception.shared-preference.read-write")
	(extension "com.apple.security.exception.shared-preference.read-only")
	(preference-domain "com.apple.hangtracer")
	(preference-domain "com.apple.Accessibility")
	(preference-domain "com.apple.springboard")
	(preference-domain "com.apple.WatchListKit")
	(preference-domain "com.apple.MobileStore")
	(preference-domain "com.apple.AppStore")
	(require-entitlement "com.apple.watchlist.private")
	(require-all
		(require-not (preference-domain "com.apple.PrototypeTools"))
		(require-any
			(require-entitlement "com.apple.itunesstored.private")
			(require-all
				(preference-domain "com.apple.security")
				(process-attribute 9))
			(require-all
				(preference-domain "com.apple.imessage.bag")
				(require-any
					(require-entitlement "com.apple.private.ids.remoteurlconnection")
					(require-entitlement "com.apple.private.imcore.imremoteurlconnection")))
			(require-all
				(preference-domain "com.apple.facetime.bag")
				(require-any
					(require-entitlement "com.apple.private.ids.remoteurlconnection")
					(require-entitlement "com.apple.private.imcore.imremoteurlconnection")))
			(require-all
				(preference-domain "com.apple.AppleMediaServices")
				(require-entitlement "com.apple.private.applemediaservices"))
			(require-all
				(preference-domain "com.apple.AvatarUI.Staryu")
				(require-entitlement "com.apple.private.avatar.store"))
			(require-all
				(preference-domain "com.apple.avfoundation.frecents")
				(require-entitlement "com.apple.avfoundation.allows-access-to-device-list"))
			(require-all
				(preference-domain "com.apple.MobileAsset")
				(require-entitlement "com.apple.private.assets.accessible-asset-types"))
			(require-all
				(preference-domain "com.apple.bulletinboard")
				(require-entitlement "com.apple.bulletinboard.dataprovider"))
			(require-all
				(preference-domain "com.apple.storeservices.itfe")
				(require-entitlement "com.apple.itunesstored.private"))
			(require-all
				(preference-domain "com.apple.proactive.PersonalizationPortrait")
				(require-entitlement "com.apple.coreduetd.allow")))))
(allow managed-preference-read
	(preference-domain "kCFPreferencesAnyApplication")
	(extension "com.apple.security.exception.managed-preference.read-only"))
(allow syscall-unix)
