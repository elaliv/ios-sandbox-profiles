(allow socket-ioctl)
(allow system-privilege)
(allow user-preference-read
	(preference-domain "com.apple.locationd")
	(require-any (preference-domain "com.apple.nanolifestyle.connectedgym")
(preference-domain "com.apple.nanolifestyle.sessiontrackerapp")
(preference-domain "com.apple.nanolifestyle.privacy")
(preference-domain "com.apple.nanolifestyle")
(preference-domain "com.apple.Fitness.activity-widget")
(preference-domain "com.apple.Fitness")
(preference-domain "com.apple.ActivitySharing")
(preference-domain "com.apple.private.health.feature-availability")
(preference-domain "com.apple.private.health.heart-rhythm")
(preference-domain "com.apple.DeepBreathing"))
	(preference-domain "com.apple.AppSupport")
	(preference-domain "com.apple.CoreMotion")
	(preference-domain "com.apple.nanoprefsyncd")
	(preference-domain "com.apple.marco")
	(preference-domain "com.apple.pairedsync")
	(preference-domain "com.apple.logging")
	(preference-domain "com.apple.mmcs")
	(preference-domain "com.apple.GEO")
	(preference-domain "com.apple.CFNetwork")
	(preference-domain "com.apple.ET")
	(preference-domain "kCFPreferencesAnyApplication")
	(preference-domain "com.apple.SOS")
	(require-any (preference-domain "com.apple.dt.Xcode")
(preference-domain "com.apple.healthlite"))
	(preference-domain "com.apple.demo-settings")
	(preference-domain "com.apple.hangtracer")
	(preference-domain "com.apple.mobilephone")
	(preference-domain "com.apple.ids")
	(preference-domain "com.apple.pairedsyncd")
	(preference-domain "com.apple.carrier")
	(preference-domain "com.apple.NanoRegistry")
	(preference-domain "com.apple.conference")
	(preference-domain "com.apple.stockholm")
	(preference-domain "com.apple.persistentconnection")
	(preference-domain "com.apple.healthd")
	(preference-domain "com.apple.CoreDuet")
	(preference-domain "com.apple.DataMigration")
	(preference-domain "com.apple.icloud.findmydeviced.postwipe")
	(preference-domain "com.apple.AOSNotification.public.notbackedup")
	(preference-domain "com.apple.PeoplePicker")
	(preference-domain "com.apple.icloud.findmydeviced.public.notbackedup")
	(extension "com.apple.security.exception.shared-preference.read-write")
	(extension "com.apple.security.exception.shared-preference.read-only")
	(preference-domain "com.apple.iokit.IOMobileGraphicsFamily")
	(require-any (preference-domain "com.apple.AppStore")
(preference-domain "com.apple.MobileStore"))
	(preference-domain "com.apple.itunesstored")
	(preference-domain "com.apple.storeservices.itfe")
	(require-entitlement "com.apple.itunesstored.private")
	(require-all
		(preference-domain "com.apple.PrototypeTools")
		(require-any
			(require-all
				(preference-domain "com.apple.security")
				(process-attribute 9))
			(require-all
				(preference-domain "com.apple.AvatarUI.Staryu")
				(require-entitlement "com.apple.private.avatar.store"))
			(require-all
				(preference-domain "com.apple.avfoundation.frecents")
				(require-entitlement "com.apple.avfoundation.allows-access-to-device-list"))
			(require-all
				(preference-domain "com.apple.MobileAsset")
				(require-entitlement "com.apple.private.assets.accessible-asset-types"))
			(require-all
				(preference-domain "com.apple.bulletinboard")
				(require-entitlement "com.apple.bulletinboard.dataprovider"))
			(require-all
				(preference-domain "com.apple.proactive.PersonalizationPortrait")
				(require-entitlement "com.apple.coreduetd.allow")))))
(allow managed-preference-read
	(preference-domain "kCFPreferencesAnyApplication")
	(extension "com.apple.security.exception.managed-preference.read-only"))
(allow user-preference-write
	(require-any (preference-domain "com.apple.nanolifestyle.connectedgym")
(preference-domain "com.apple.nanolifestyle.sessiontrackerapp")
(preference-domain "com.apple.nanolifestyle.privacy")
(preference-domain "com.apple.nanolifestyle")
(preference-domain "com.apple.Fitness.activity-widget")
(preference-domain "com.apple.Fitness")
(preference-domain "com.apple.ActivitySharing")
(preference-domain "com.apple.private.health.feature-availability")
(preference-domain "com.apple.private.health.heart-rhythm")
(preference-domain "com.apple.DeepBreathing"))
	(preference-domain "com.apple.healthd")
	(preference-domain "com.apple.SOS")
	(preference-domain "com.apple.ET"))
