(sysctl-name "kern.maxfilesperproc")
(sysctl-name "kern.monotonicclock")
(sysctl-name "kern.monotoniclock_offset_usecs")
(sysctl-name "kern.usrstack64")
(sysctl-name "kern.usrstack")
(sysctl-name "kern.hostid")
