(version 1)
(deny default)
(allow darwin-notification-post)
(allow dynamic-code-generation)
(allow file-clone)
(allow file-link)
(allow file-test-existence)
(allow iokit-get-properties)
(allow mach-cross-domain-lookup)
(allow mach-lookup
	(global-name "com.apple.pluginkit.pkd")
	(global-name "com.apple.hangtracerd")
	(extension "com.apple.pluginkit.plugin-service")
	(global-name "com.apple.analyticsd")
	(global-name "com.apple.diagnosticd")
	(global-name "com.apple.ibooks.BLService")
	(require-any (global-name "com.apple.CoreAuthentication.daemon.libxpc")
(global-name "com.apple.ctkd.token-client"))
	(require-any (global-name "com.apple.appstored.xpc.request")
(global-name "com.apple.appstored.xpc.jobmanager"))
	(global-name "com.apple.itunesstored.xpc")
	(global-name "com.apple.system.libinfo.muser")
	(require-any (global-name "com.apple.lsd")
(global-name "com.apple.lsd.open")
(global-name "com.apple.duetknowledged.activity"))
	(require-any (global-name "com.apple.lsd.icons")
(global-name "com.apple.coreservices.lsuseractivitymanager.xpc")
(global-name "com.apple.assertiond.processassertionconnection"))
	(global-name "com.apple.appstored.xpc.updates")
	(global-name "com.apple.logd.events")
	(global-name "com.apple.system.notification_center")
	(global-name "com.apple.system.logger")
	(require-any (global-name "com.apple.appsupport.cplogd")
(global-name "com.apple.dyld.closured"))
	(local-name "com.apple.cfprefsd.agent")
	(global-name "com.apple.lsd.openurl")
	(global-name "com.apple.managedconfiguration.profiled.public")
	(global-name "com.apple.containermanagerd")
	(global-name "com.apple.mobilegestalt.xpc")
	(global-name "com.apple.cfprefsd.daemon")
	(global-name "com.apple.lsd.mapdb")
	(global-name "com.apple.cfprefsd.agent")
	(global-name "com.apple.distributed_notifications@1v3")
	(xpc-service-name-regex #".+")
	(global-name "com.apple.aggregated")
	(global-name "com.apple.logd")
	(require-any (global-name "com.apple.lsd.advertisingidentifiers")
(global-name "com.apple.tccd"))
	(require-entitlement "com.apple.itunesstored.private")
	(require-all
		(global-name "com.apple.ReportCrash.SimulateCrash")
		(require-any
			(process-attribute 9)
			(extension "com.apple.security.exception.mach-lookup.global-name")))
	(require-all
		(local-name-regex #".+")
		(extension "com.apple.security.exception.mach-lookup.local-name"))
	(require-all
		(global-name-regex #".+")
		(extension "com.apple.security.exception.mach-lookup.global-name"))
	(require-all
		(global-name "com.apple.mobile.usermanagerd.xpc")
		(process-attribute 9))
	(require-all
		(global-name "com.apple.PrototypeTools.domainserver")
		(require-any
			(require-all
				(global-name "com.apple.Honeybee.event-notify")
				(process-attribute 9))
			(require-all
				(global-name "com.apple.Carousel.eligibilityservice")
				(require-entitlement "com.apple.Carousel.eligibilityservice"))
			(require-all
				(global-name "com.apple.dmd.policy")
				(require-entitlement "com.apple.private.dmd.policy"))
			(require-all
				(global-name "com.apple.remotemanagementd.management-state")
				(require-any
					(require-entitlement "com.apple.remotemanagementd.ask-for-time")
					(require-entitlement "com.apple.remotemanagementd.management-state")
					(require-entitlement "com.apple.remotemanagementd.setup-access")))
			(require-all
				(global-name "com.apple.siri.VoiceShortcuts.xpc")
				(require-entitlement "com.apple.siri.VoiceShortcuts.xpc"))
			(require-all
				(global-name "com.apple.spotlight.IndexAgent")
				(require-entitlement "com.apple.private.corespotlight.search.internal"))
			(require-all
				(global-name "com.apple.securityd.ckks")
				(require-entitlement "com.apple.private.ckks"))
			(require-all
				(global-name "com.apple.spotlight.SearchAgent")
				(require-entitlement "com.apple.private.corespotlight.search.internal"))
			(require-all
				(require-any (global-name "com.apple.avatar.service")
(global-name "com.apple.avatar.support"))
				(require-entitlement "com.apple.private.avatar.store"))
			(require-all
				(global-name "com.apple.appleneuralengine.private")
				(require-entitlement "com.apple.appleneuralengine.private.allow"))
			(require-all
				(require-any (global-name "com.apple.photos.ImageConversionService")
(global-name "com.apple.photos.VideoConversionService"))
				(require-entitlement "com.apple.private.photos.service.mediaconversion"))
			(require-all
				(global-name "com.apple.symptom_analytics")
				(require-any
					(require-entitlement "com.apple.symptoms.NetworkOfInterest")
					(require-entitlement "com.apple.symptom_analytics.configure")
					(require-entitlement "com.apple.symptom_analytics.healthcheck")
					(require-entitlement "com.apple.symptom_analytics.query")
					(require-entitlement "com.apple.symptom_analytics.refresh")
					(require-entitlement "com.apple.symptom_analytics.reset")
					(require-entitlement "com.apple.symptom_analytics.setsnapshot")
					(require-entitlement "com.apple.symptom_analytics.setwatchpoint")
					(require-entitlement "com.apple.symptom_analytics.train")))
			(require-all
				(global-name "com.apple.appstored.xpc.request")
				(require-any
					(require-entitlement "com.apple.appstored.install-system-apps")
					(require-entitlement "com.apple.appstored.install-apps")))
			(require-all
				(global-name "com.apple.mobileassetd")
				(require-entitlement "com.apple.private.assets.accessible-asset-types"))
			(require-all
				(global-name "com.apple.mobileassetd.v2")
				(require-entitlement "com.apple.private.assets.accessible-asset-types"))
			(require-all
				(global-name "com.apple.tailspind")
				(require-any
					(require-entitlement "com.apple.tailspin.config-apply")
					(require-entitlement "com.apple.tailspin.dump-output")))
			(require-all
				(global-name "com.apple.rtcreportingd")
				(require-entitlement "com.apple.private.rtcreportingd"))
			(require-all
				(global-name "com.apple.coreduetd.context")
				(require-entitlement "com.apple.coreduetd.context"))
			(require-all
				(global-name "com.apple.nfcd.service.corenfc")
				(require-entitlement "com.apple.developer.nfc.readersession.formats"))
			(require-all
				(global-name "com.apple.coreduetd")
				(require-entitlement "com.apple.coreduetd.allow"))
			(require-all
				(global-name "com.apple.suggestd.PersonalizationPortrait.DeletionTracking")
				(require-entitlement "com.apple.coreduetd.allow"))
			(require-all
				(global-name "com.apple.coreduetd.people")
				(require-entitlement "com.apple.coreduetd.allow"))
			(require-all
				(global-name "com.apple.coreduetd.knowledge")
				(require-entitlement "com.apple.coreduetd.allow"))
			(require-all
				(global-name "com.apple.corecaptured")
				(require-entitlement "com.apple.corecapture.manager-access"))
			(require-all
				(global-name "com.apple.adid")
				(require-entitlement "adi-client"))
			(require-all
				(global-name "com.apple.symptom_diagnostics")
				(require-entitlement "com.apple.symptom_diagnostics.report"))
			(require-all
				(global-name "com.apple.absd")
				(require-any
					(require-entitlement "abs-client")
					(require-entitlement "absinthe-client")))
			(require-all
				(global-name "com.apple.absinthed")
				(require-entitlement "absinthe-client"))
			(require-all
				(global-name "com.apple.contactsd.launch-services-proxy")
				(require-entitlement "com.apple.private.contactsui"))
			(require-all
				(global-name "com.apple.biometrickitd")
				(require-entitlement "com.apple.private.bmk.allow"))
			(require-all
				(global-name "com.apple.pearld")
				(require-entitlement "com.apple.private.bmk.allow"))
			(require-all
				(global-name "com.apple.dprivacyd")
				(require-entitlement "com.apple.private.dprivacyd.allow"))
			(require-all
				(global-name "com.apple.telephonyutilities.callservicesdaemon.callprovidermanager")
				(require-entitlement "com.apple.telephonyutilities.callservicesd"))
			(require-all
				(global-name "com.apple.logd.admin")
				(require-any
					(require-entitlement "com.apple.private.logging.diagnostic")
					(require-entitlement "com.apple.diagnosticd.diagnostic")))
			(require-all
				(global-name "com.apple.springboard.statusbarservices")
				(require-entitlement "com.apple.springboard.statusbarstyleoverrides"))
			(require-all
				(global-name "com.apple.passd.trusted-device-enrollment-info-provider")
				(require-entitlement "com.apple.private.passkit.trusted-device-enrollment-info"))
			(require-all
				(global-name "com.apple.bulletinboard.dataproviderconnection")
				(require-entitlement "com.apple.bulletinboard.dataprovider"))
			(require-all
				(global-name "com.apple.appstored.xpc.updates")
				(require-entitlement "com.apple.appstored.update-apps"))
			(require-all
				(require-any (global-name "com.apple.appstored.xpc.request")
(global-name "com.apple.appstored.xpc.jobmanager"))
				(require-entitlement "com.apple.appstored.install-apps")))))
(allow nvram*)
(allow nvram-delete)
(allow nvram-get)
(allow nvram-set)
(allow process-info*)
(allow process-info-codesignature)
(allow process-info-dirtycontrol)
(allow process-info-listpids)
(allow process-info-rusage)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow process-info-pidfileportinfo)
(allow process-info-setcontrol)
(allow socket-ioctl)
(allow sysctl-read
	(require-any (sysctl-name "kern.memorystatus_level")
(sysctl-name "hw.ncpu")
(sysctl-name "hw.model"))
	(sysctl-name "hw.availcpu")
	(sysctl-name "vm.footprint_suspend")
	(extension "com.apple.security.exception.sysctl.read-write")
	(extension "com.apple.security.exception.sysctl.read-only")
	(require-any (sysctl-name "kern.procargs2.")
(sysctl-name "kern.proc."))
	(require-entitlement "com.apple.security.exception.process-info")
	(require-all
		(process-attribute 9)
		(require-any (sysctl-name "kern.proc.pid.")
(sysctl-name "kern.argmax")))
	(require-all
		(sysctl-name "sysctl.proc_native")
		(require-any
			(require-any (sysctl-name "hw.logicalcpu_max")
(sysctl-name "hw.logicalcpu")
(sysctl-name "hw.l3cachesize_compat")
(sysctl-name "hw.l3cachesize")
(sysctl-name "hw.l3settings")
(sysctl-name "hw.l1dcachesize")
(sysctl-name "hw.l1dcachesize_compat")
(sysctl-name "hw.l1icachesize_compat")
(sysctl-name "hw.l1icachesize")
(sysctl-name "hw.l2cachesize")
(sysctl-name "hw.l2cachesize_compat")
(sysctl-name "hw.l2settings")
(sysctl-name "hw.cachelinesize_compat")
(sysctl-name "hw.cachelinesize")
(sysctl-name "hw.cpufrequency_max")
(sysctl-name "hw.cpufrequency_compat")
(sysctl-name "hw.cpufrequency")
(sysctl-name "hw.cpufamily")
(sysctl-name "hw.cpusubtype")
(sysctl-name "hw.cpu64bit_capable")
(sysctl-name "hw.cputype")
(sysctl-name "hw.vectorunit")
(sysctl-name "hw.tbfrequency")
(sysctl-name "hw.tbfrequency_compat")
(sysctl-name "hw.memsize")
(sysctl-name "hw.machine")
(sysctl-name "hw.pagesize")
(sysctl-name "hw.pagesize_compat")
(sysctl-name "hw.physicalcpu")
(sysctl-name "hw.physicalcpu_max")
(sysctl-name "hw.physmem")
(sysctl-name "hw.usermem")
(sysctl-name "hw.busfrequency_compat")
(sysctl-name "hw.busfrequency")
(sysctl-name "hw.byteorder")
(sysctl-name "hw.activecpu")
(sysctl-name "kern.maxvnodes")
(sysctl-name "kern.maxproc")
(sysctl-name "kern.maxfilesperproc")
(sysctl-name "kern.monotonicclock")
(sysctl-name "kern.monotoniclock_offset_usecs")
(sysctl-name "kern.usrstack64")
(sysctl-name "kern.usrstack")
(sysctl-name "kern.hostid")
(sysctl-name "kern.hostname")
(sysctl-name "kern.ostype")
(sysctl-name "kern.osproductversion")
(sysctl-name "kern.osvariant_status")
(sysctl-name "kern.osversion")
(sysctl-name "kern.osrelease")
(sysctl-name "kern.clockrate")
(sysctl-name "kern.saved_ids")
(sysctl-name "kern.secure_kernel")
(sysctl-name "kern.ngroups")
(sysctl-name "kern.boottime")
(sysctl-name "kern.bootargs")
(sysctl-name "kern.development")
(sysctl-name "kern.waketime")
(sysctl-name "kern.version")
(sysctl-name "vm.loadavg")
(sysctl-name "sysctl.name2oid")
(sysctl-name "security.mac.sandbox.sentinel"))
			(require-any (sysctl-name "kern.memorystatus_level")
(sysctl-name "hw.ncpu")
(sysctl-name "hw.model")))))
(allow system-audit)
(allow system-privilege)
